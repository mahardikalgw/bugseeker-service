# Copy to .env and fill in real values.
# Runtime reads these via config/runtime.exs (prod) or Dotenv (dev/test).

# Database (required — the job queue and review runs are stored in Postgres)
DATABASE_URL=postgres://localhost:5432/codeseeker_dev

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Server
PORT=4000
PHX_SERVER=true
