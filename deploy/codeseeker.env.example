# Used by systemd EnvironmentFile on the VPS: cp to /etc/codeseeker.env, chmod 600.

# PostgreSQL (required) — Oban queue + review runs live here.
DATABASE_URL=postgres://codeseeker:PASSWORD@localhost:5432/codeseeker_prod

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/codeseeker-app.pem
GITHUB_WEBHOOK_SECRET=

PORT=4000
PHX_SERVER=true
